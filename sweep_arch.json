{
  "_comment": "Architecture-comparison / retune campaign for the temporal nets (gru/lstm/transformer). Run with: uv run python scripts/train_campaign.py --sweep sweep_arch.json [--dry-run]. Each run auto-versions into its own checkpoints/v<version>/ and is gauntleted (tournament block) against the baselines + existing resnet incumbents, so cross-arch comparison is built in. defaults set history=1 (temporal archs ignore stacked history) and pin the temporal knobs; each run overrides only network.arch + the one knob it varies. The R-NaD knobs (lr, eta, neurd_clip) were tuned for the ResNet, so the lr/eta variants below are the retune axis. Screening at 80k to match the canonical horizon; drop total_iters for a faster first pass.",
  "defaults": {
    "encoding.history": 1,
    "network.channels": 128,
    "network.value_hidden": 128,
    "network.enc_blocks": 4,
    "network.mixer_dim": 128,
    "network.mixer_layers": 2,
    "network.nhead": 4,
    "network.max_seq": 512,
    "rnad.eta": 0.5,
    "rnad.iteration_steps": 1000,
    "rnad.gamma": 1.0,
    "rnad.rho_clip": 1.0,
    "rnad.c_clip": 1.0,
    "rnad.neurd_clip": 2.5,
    "rnad.value_coef": 1.0,
    "rnad.full_action_neurd": true,
    "rnad.lr": 5e-05,
    "rnad.grad_clip": 10.0,
    "rnad.fast_learner": true,
    "rnad.compile_net": false,
    "rnad.amp": true,
    "train.games_per_iter": 8,
    "train.learner_steps_per_iter": 4,
    "train.total_iters": 80000,
    "train.batch_trajectories": 32,
    "train.buffer_capacity": 4096,
    "train.num_actors": 1,
    "train.device": "cuda",
    "train.seconds_per_player": 900.0,
    "train.checkpoint_every": 10000,
    "train.seed": 0,
    "train.eval_every": 0,
    "train.eval_games": 50,
    "train.eval_opponents": ["random", "attacker", "trout"],
    "train.progress": true,
    "train.idle_schedule": true,
    "train.train_start_hour": 19,
    "train.train_stop_hour": 6,
    "train.train_days": [0, 1, 2, 3, 4],
    "train.async_actors": 16,
    "train.traj_queue_size": 256,
    "train.min_buffer_to_train": 64,
    "train.drain_per_cycle": 64,
    "train.weight_broadcast_every": 20,
    "train.prefetch_depth": 2
  },
  "runs": [
    { "name": "arch-gru-base", "bump": "minor",
      "overrides": { "network.arch": "gru" } },
    { "name": "arch-lstm-base", "bump": "minor",
      "overrides": { "network.arch": "lstm" } },
    { "name": "arch-transformer-base", "bump": "minor",
      "overrides": { "network.arch": "transformer" } },

    { "name": "arch-gru-lr1e4", "bump": "minor",
      "overrides": { "network.arch": "gru", "rnad.lr": 1e-4 } },
    { "name": "arch-transformer-lr1e4", "bump": "minor",
      "overrides": { "network.arch": "transformer", "rnad.lr": 1e-4 } },

    { "name": "arch-gru-eta0.2", "bump": "minor",
      "overrides": { "network.arch": "gru", "rnad.eta": 0.2 } },
    { "name": "arch-transformer-eta0.2", "bump": "minor",
      "overrides": { "network.arch": "transformer", "rnad.eta": 0.2 } },

    { "name": "arch-gru-mixer3L", "bump": "minor",
      "overrides": { "network.arch": "gru", "network.mixer_layers": 3 } },
    { "name": "arch-transformer-3L", "bump": "minor",
      "overrides": { "network.arch": "transformer", "network.mixer_layers": 3 } },

    { "name": "arch-gru-enc3", "bump": "minor",
      "overrides": { "network.arch": "gru", "network.enc_blocks": 3 } }
  ],
  "tournament": {
    "pair_games": 8,
    "baselines": ["random", "trout", "mht"],
    "incumbents": 5,
    "keep_top": null,
    "workers": 8,
    "threshold": 0.05,
    "out": "results/tournament.jsonl"
  }
}
