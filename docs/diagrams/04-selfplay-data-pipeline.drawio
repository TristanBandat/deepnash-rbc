<mxfile host="Electron" agent="claude-code">
  <diagram id="selfplay-pipeline" name="selfplay-data-pipeline">
    <mxGraphModel dx="1205" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="From a self-play RBC game to training data (agent.py · encoding/ · replay.py)" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="frameA" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(A) one RBC turn — reconchess callback cycle, per player" vertex="1">
          <mxGeometry height="470" width="700" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="handle_opponent_move_result&lt;br&gt;capture ping (square / none); encoder starts a new frame" vertex="1">
          <mxGeometry height="55" width="300" x="70" y="115" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" value="choose_sense — decision 1&lt;br&gt;pick a 3×3 sense center (64 squares; legal set from reconchess)" vertex="1">
          <mxGeometry height="65" width="300" x="70" y="195" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="handle_sense_result&lt;br&gt;revealed pieces in the 3×3 window → encoder" vertex="1">
          <mxGeometry height="55" width="300" x="70" y="285" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" value="choose_move — decision 2&lt;br&gt;pick from the turn’s candidate moves + explicit pass" vertex="1">
          <mxGeometry height="65" width="300" x="70" y="365" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="handle_move_result&lt;br&gt;requested vs taken (truncation), capture square; commit frame to history" vertex="1">
          <mxGeometry height="65" width="300" x="70" y="455" as="geometry" />
        </mxCell>
        <mxCell id="aN1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="own pieces are always known exactly — RBC reports the true&amp;nbsp;&lt;div&gt;result of your own moves and every capture against you.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Opponent information enters ONLY through the sense&amp;nbsp;&lt;/div&gt;&lt;div&gt;window and capture pings; there is no explicit belief state.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="280" x="430" y="115" as="geometry" />
        </mxCell>
        <mxCell id="aN2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="both players are RNaDPlayer instances sharing the SAME network&amp;nbsp;&lt;div&gt;snapshot; play_one_game runs a full LocalGame under&amp;nbsp;&lt;/div&gt;&lt;div&gt;torch.no_grad. Shaded boxes = the two decision points&amp;nbsp;&lt;/div&gt;&lt;div&gt;recorded per turn.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="430" y="310" as="geometry" />
        </mxCell>
        <mxCell id="ea1" edge="1" parent="1" source="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="a2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2" edge="1" parent="1" source="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="a3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea3" edge="1" parent="1" source="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="a4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea4" edge="1" parent="1" source="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="a5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea5" edge="1" parent="1" source="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="a1" value="next turn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="405" y="487" />
              <mxPoint x="405" y="142" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="frameB" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(B) observation encoding — ObservationEncoder (no belief reconstruction)" vertex="1">
          <mxGeometry height="470" width="690" x="770" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacing=8;" value="one frame = 19 binary 8×8 planes&lt;br&gt;0–5    own pieces by type (P N B R Q K)&lt;br&gt;6–11  opponent pieces from the MOST RECENT sense&lt;br&gt;12     sense window mask (3×3)&lt;br&gt;13     square where our piece was just captured&lt;br&gt;14     square where we just captured&lt;br&gt;15     our last move: from-square&lt;br&gt;16     our last move: to-square&lt;br&gt;17     move-truncated flag (requested ≠ taken, whole plane)&lt;br&gt;18     color plane (White = 1)" vertex="1">
          <mxGeometry height="300" width="330" x="800" y="115" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="history stack: deque of the last H frames&lt;br&gt;(H−1 committed + current; H = history, e.g. 128)&lt;br&gt;→ network input [H × 19, 8, 8], built on demand&lt;br&gt;for inference — NOT stored per step (see D)" vertex="1">
          <mxGeometry height="120" width="270" x="1160" y="115" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="the frame stack is the agent’s only memory: an implicit belief&amp;nbsp;&lt;div&gt;over the hidden opponent position is LEARNED across the&amp;nbsp;&lt;/div&gt;&lt;div&gt;stacked history (DeepNash-style), never constructed.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Own pieces are tracked as a plain {square: piece_type} map —&amp;nbsp;&lt;/div&gt;&lt;div&gt;RBC moves are frequently illegal under full chess rules,&amp;nbsp;&lt;/div&gt;&lt;div&gt;so python-chess legality machinery is avoided.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="1160" y="270" as="geometry" />
        </mxCell>
        <mxCell id="eAB" edge="1" parent="1" source="frameA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;horizontal=0;" target="frameB" value="capture ping · sense result · move result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb1" edge="1" parent="1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" target="b2" value="stack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="frameC" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(C) policy query at each decision point — RNaDPlayer" vertex="1">
          <mxGeometry height="330" width="700" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="obs [H·19, 8, 8] → DeepNashNet (no-grad, eval)&lt;br&gt;→ value v(s), sense logits [64], move logits [4673]" vertex="1">
          <mxGeometry height="80" width="300" x="70" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacing=6;" value="move action space:&lt;br&gt;AlphaZero 8×8×73 = 4672 planes&lt;br&gt;+ 1 explicit pass = 4673&lt;br&gt;(queen promotions fold into queen planes; under-promotions get own planes; legal sets always come from reconchess — no own move generator)" vertex="1">
          <mxGeometry height="120" width="280" x="430" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="mask logits to the legal set (−∞ elsewhere)&lt;br&gt;→ log-softmax → sample a ∼ π(·|s)&lt;br&gt;(multinomial in self-play; argmax in eval)" vertex="1">
          <mxGeometry height="80" width="300" x="70" y="770" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="record log μ(a|s): the acting policy IS the behavior policy μ used later for v-trace off-policy correction" vertex="1">
          <mxGeometry height="80" width="280" x="430" y="790" as="geometry" />
        </mxCell>
        <mxCell id="eBC" edge="1" parent="1" source="frameB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=0.02;exitY=1;entryX=0.3;entryY=0;" target="c1" value="obs tensor at each decision">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="784" y="570" />
              <mxPoint x="160" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eAC" edge="1" parent="1" source="frameA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=0.35;exitY=1;entryX=0.7;entryY=0;" target="c1" value="2 decisions per turn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec1" edge="1" parent="1" source="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="c3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" edge="1" parent="1" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;dashed=1;fontSize=10;fontColor=#666666;exitX=0;exitY=0.85;entryX=1;entryY=0.3;" target="c3" value="legal indices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec3" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" target="c4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="frameD" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(D) trajectory records — replay.py" vertex="1">
          <mxGeometry height="330" width="690" x="770" y="600" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;spacing=8;" value="Step (one per decision point):&lt;br&gt;• obs uint8 [19, 8, 8] — the in-progress frame ONLY&lt;br&gt;• turn — index into Trajectory.frames&lt;br&gt;• head ∈ {SENSE, MOVE}&lt;br&gt;• legal action indices&lt;br&gt;• action a  ·  behavior log μ(a|s)" vertex="1">
          <mxGeometry height="110" width="310" x="800" y="650" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Trajectory: the player’s full Step sequence (≈ 2 steps per turn) + frames: each committed frame stored ONCE per turn (history deduplicated — steps share their stacks); one game → 2 trajectories (White + Black)" vertex="1">
          <mxGeometry height="110" width="270" x="1160" y="650" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="handle_game_end: z ∈ {+1, 0, −1} set on the whole trajectory → sparse reward r_t = 0 except r_T = z (aborted games are dropped entirely)" vertex="1">
          <mxGeometry height="100" width="310" x="800" y="790" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" value="→ trajectory queue → replay buffer&lt;br&gt;learner samples B = 32 trajectories, flattens them to N decision steps and rebuilds the [H·19, 8, 8] stacks on-GPU (one gather over the deduplicated frames)&lt;br&gt;(continued in diagram 03)" vertex="1">
          <mxGeometry height="100" width="270" x="1160" y="790" as="geometry" />
        </mxCell>
        <mxCell id="eCD" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="d1" value="append one Step">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed1" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="d2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed2" edge="1" parent="1" source="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;dashed=1;fontSize=10;fontColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="d4" value="at game end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed3" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="d4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
