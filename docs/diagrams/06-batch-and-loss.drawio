          <mxGeometry height="290" width="690" x="770" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" value="ONE forward pass over all N steps&lt;br&gt;→ v(s), logits (θ) + reg logits (π_reg, frozen)" vertex="1">
          <mxGeometry height="80" width="300" x="800" y="480" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;spacing=8;" value="single scalar loss:&lt;br&gt;value = mean over all N of (v − vs)²&lt;br&gt;policy = NeuRD summed, ÷ N&lt;br&gt;loss = policy + 1.0 · value&lt;br&gt;(÷ N → loss value is scale-stable across batches)" vertex="1">
