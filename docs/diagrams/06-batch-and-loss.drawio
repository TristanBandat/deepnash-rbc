        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="reward transform + v-trace recurrence run over each trajectory SEPARATELY — the recurrence never crosses a trajectory boundary ([T_max, B] grid: one column per trajectory)" vertex="1">
          <mxGeometry height="90" width="310" x="70" y="480" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" value="outputs per step: target vs_t, advantage A_t — detached scalars; no gradient flows through this path" vertex="1">
