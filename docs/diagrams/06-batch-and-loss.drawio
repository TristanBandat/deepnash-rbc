        <mxCell id="eBuf" edge="1" parent="1" source="buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t2" value="&lt;font style=&quot;font-size: 6px; line-height: 100%;&quot;&gt;sample B = 32 uniformly&lt;br&gt;(without replacement within a batch)&lt;/font&gt;">
