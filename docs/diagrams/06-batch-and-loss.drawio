        </mxCell>
        <mxCell id="b3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="fast path: vectorized across the 32 columns, but each column’s&amp;nbsp;&lt;div&gt;accumulator sees only its own deltas,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;mathematically identical&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;to 32 independent recurrences (padding: ρ = c = δ = 0)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="310" x="70" y="590" as="geometry" />
        </mxCell>
        <mxCell id="eb12" edge="1" parent="1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="b2" value="">
