        <mxCell id="zW" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="z_W" vertex="1">
          <mxGeometry height="50" width="50" x="900" y="205" as="geometry" />
        </mxCell>
        <mxCell id="zWnote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="z ∈ {+1, 0, −1} from this&amp;nbsp;&lt;div&gt;player’s perspective,&amp;nbsp;&lt;/div&gt;&lt;div&gt;set once at game end&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="115" x="965" y="205" as="geometry" />
        </mxCell>
        <mxCell id="wT1" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#333333;" value="turn 1" vertex="1">
          <mxGeometry height="20" width="80" x="430" y="255" as="geometry" />
