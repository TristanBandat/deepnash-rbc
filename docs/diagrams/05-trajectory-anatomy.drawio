          <mxGeometry height="40" width="40" x="470" y="420" as="geometry" />
        </mxCell>
        <mxCell id="bS2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" value="S" vertex="1">
          <mxGeometry height="40" width="40" x="530" y="420" as="geometry" />
        </mxCell>
        <mxCell id="bM2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=12;" value="M" vertex="1">
          <mxGeometry height="40" width="40" x="570" y="420" as="geometry" />
        </mxCell>
        <mxCell id="bDots" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" value="⋯" vertex="1">
          <mxGeometry height="40" width="40" x="630" y="420" as="geometry" />
        </mxCell>
        <mxCell id="bST" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" value="S" vertex="1">
          <mxGeometry height="40" width="40" x="690" y="420" as="geometry" />
        </mxCell>
        <mxCell id="bMT" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=12;" value="M" vertex="1">
          <mxGeometry height="40" width="40" x="730" y="420" as="geometry" />
        </mxCell>
        <mxCell id="zB" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="z_B" vertex="1">
          <mxGeometry height="50" width="50" x="800" y="415" as="geometry" />
        </mxCell>
        <mxCell id="zBnote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="z_B = −z_W in decisive games; both 0 on a draw.&amp;nbsp;&lt;div&gt;Lengths may differ from White’s (ragged).&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="215" x="865" y="415" as="geometry" />
        </mxCell>
        <mxCell id="bNote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="same structure as White’s trajectory — enters the buffer as an independent training example" vertex="1">
          <mxGeometry height="20" width="520" x="430" y="470" as="geometry" />
        </mxCell>
        <mxCell id="eGW" edge="1" parent="1" source="gameBox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" target="wS1" value="White seat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eGB" edge="1" parent="1" source="gameBox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" target="bS1" value="Black seat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eStep" edge="1" parent="1" source="wM2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" target="stepBox" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="box1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacing=8;" value="The trajectory is the atomic unit everywhere:&lt;br&gt;• actor → learner queue transports whole trajectories&lt;br&gt;• replay buffer stores and samples whole trajectories (B = 32)&lt;br&gt;• v-trace needs the intact sequence — the recurrence walks backward from the terminal reward, so trajectories are never fragmented" vertex="1">
          <mxGeometry height="150" width="420" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="box2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacing=8;" value="Variable length:&lt;br&gt;games end on king capture or clock → ragged trajectory lengths. The fast learner pads a batch to [T_max, B] and runs one vectorized backward recurrence; padding carries ρ = c = δ = 0 and contributes nothing." vertex="1">
          <mxGeometry height="150" width="420" x="500" y="560" as="geometry" />
        </mxCell>
        <mxCell id="box3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=10;align=left;spacing=8;fontStyle=0;" value="One shared network for both colors:&lt;br&gt;• no separate White / Black models — both trajectories update the same θ&lt;br&gt;• the board is NOT mirrored for Black: absolute coordinates + a color plane (channel 18) tell the network its seat&lt;br&gt;• once z is assigned, the two trajectories are independent training examples — nothing couples them in the loss&lt;br&gt;• the zero-sum structure enters only through z_W = −z_B" vertex="1">
          <mxGeometry height="150" width="470" x="960" y="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
