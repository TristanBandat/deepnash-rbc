<mxfile host="Electron" agent="claude-code">
  <diagram id="traj-anatomy" name="trajectory-anatomy">
    <mxGraphModel dx="1656" dy="828" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Anatomy of a trajectory — one player’s decision sequence over one RBC game (replay.py)" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="gameBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="one self-play game (LocalGame)&lt;br&gt;both seats played by RNaDPlayer with the SAME network snapshot θ′&lt;br&gt;(stochastic behavior: a ∼ π)" vertex="1">
          <mxGeometry height="120" width="300" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="cells:&amp;nbsp;&lt;div&gt;S = sense Step (head 0, 64 actions),&amp;nbsp;&lt;/div&gt;&lt;div&gt;M = move Step (head 1, 4673 actions).&lt;br&gt;2 Steps per turn → a ~40-turn game yields a trajectory of ~80 Steps.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="stepBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacing=8;" value="Step — one decision record:&lt;br&gt;• obs uint8 [19, 8, 8] — the in-progress frame at this decision (NOT the full history stack)&lt;br&gt;• turn — # committed frames before this decision&lt;br&gt;• head ∈ {SENSE, MOVE}&lt;br&gt;• legal action indices (from reconchess)&lt;br&gt;• action a (sampled)&lt;br&gt;• behavior log-prob log μ(a|s)&lt;br&gt;(no reward field — reward exists only at the trajectory level)" vertex="1">
          <mxGeometry height="180" width="340" x="1090" y="70" as="geometry" />
        </mxCell>
        <mxCell id="framesBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=10;align=left;spacing=8;" value="Trajectory.frames — deduplicated history:&lt;br&gt;one committed [19, 8, 8] frame per turn, stored ONCE. A Step’s network input = frames[turn−H+1 … turn−1] (blank-padded) + its own obs; the learner rebuilds the [H·19, 8, 8] stacks on-GPU with one gather. Storing full stacks per step scaled trajectory size with H (~14 MB at H = 128); deduplicated ≈ 215 KB (~66×)." vertex="1">
          <mxGeometry height="120" width="340" x="1090" y="265" as="geometry" />
        </mxCell>
        <mxCell id="labW" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="White’s trajectory — Steps in decision order" vertex="1">
          <mxGeometry height="20" width="400" x="430" y="180" as="geometry" />
        </mxCell>
