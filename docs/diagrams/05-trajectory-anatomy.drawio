        </mxCell>
        <mxCell id="wRew" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="rewards: r_t = 0 for every step … except the last: r_T = z (sparse, terminal only; Steps store no reward)" vertex="1">
          <mxGeometry height="20" width="620" x="430" y="285" as="geometry" />
        </mxCell>
        <mxCell id="eVtrace" edge="1" parent="1" style="endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#666666;fontSize=10;fontColor=#666666;" value="v-trace recurrence runs backward from z (γ = 1: undiscounted credit over ~80 steps)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="325" as="sourcePoint" />
            <mxPoint x="430" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labB" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="Black’s trajectory" vertex="1">
