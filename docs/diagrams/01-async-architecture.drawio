        <mxCell id="buffer" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Replay buffer&lt;br&gt;FIFO, capacity = 4096 trajectories" vertex="1">
