        </mxCell>
        <mxCell id="actFrame" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;" value="Actor processes  (×16, CPU, spawned once)" vertex="1">
          <mxGeometry height="420" width="380" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="actNet" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Policy network θ′&lt;br&gt;(CPU copy of θ, eval mode)" vertex="1">
          <mxGeometry height="60" width="320" x="70" y="150" as="geometry" />
        </mxCell>
        <mxCell id="actSP" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Self-play&lt;br&gt;one RBC game: RNaDPlayer (White) vs RNaDPlayer (Black)&lt;br&gt;→ two trajectories (one per player)" vertex="1">
          <mxGeometry height="100" width="320" x="70" y="250" as="geometry" />
        </mxCell>
        <mxCell id="actNote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="one torch thread per actor (no oversubscription); trajectories hold obs,&amp;nbsp;&lt;div&gt;head, action, legal set, behavior log-prob per decision step&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="320" x="70" y="370" as="geometry" />
        </mxCell>
        <mxCell id="eActNetSP" edge="1" parent="1" source="actNet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="actSP" value="sample a ∼ π">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="trajQ" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Trajectory queue&lt;br&gt;mp.Queue, maxsize = 256" vertex="1">
          <mxGeometry height="70" width="220" x="520" y="170" as="geometry" />
        </mxCell>
        <mxCell id="trajNote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="queue full → actor drops the trajectory (backpressure)&amp;nbsp;&lt;div&gt;and keeps playing&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="250" x="505" y="250" as="geometry" />
        </mxCell>
        <mxCell id="offNote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" value="Actors act with slightly stale weights θ′ — the off-policy lag is&amp;nbsp;&lt;div&gt;corrected by v-trace importance weighting in the learner&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="490" y="315" as="geometry" />
        </mxCell>
        <mxCell id="weightQ" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Per-actor weight queues (×16)&lt;br&gt;mp.Queue, maxsize = 1 (latest snapshot only)" vertex="1">
          <mxGeometry height="80" width="240" x="510" y="420" as="geometry" />
        </mxCell>
        <mxCell id="learnFrame" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;" value="Learner — main process (GPU)" vertex="1">
