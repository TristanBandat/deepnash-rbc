        </mxCell>
        <mxCell id="evalBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="Skill evaluation&lt;br&gt;every eval_every learner steps&lt;br&gt;(pauses training briefly)" vertex="1">
          <mxGeometry height="70" width="200" x="850" y="320" as="geometry" />
        </mxCell>
        <mxCell id="eReg" edge="1" parent="1" source="regBox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="update" value="">
