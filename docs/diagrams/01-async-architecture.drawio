        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Asynchronous actor–learner training (deepnash-train-async, IMPALA / DeepNash topology)" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
