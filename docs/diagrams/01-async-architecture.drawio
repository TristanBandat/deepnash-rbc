        <mxCell id="update" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;spacing=6;" value="R-NaD learner step&lt;br&gt;• sample 32 trajectories&lt;br&gt;• forward θ and frozen π_reg&lt;br&gt;• reward transform (η = 0.5)&lt;br&gt;• v-trace targets / advantages&lt;br&gt;• NeuRD + value loss → Adam" vertex="1">
          <mxGeometry height="180" width="230" x="1110" y="110" as="geometry" />
        </mxCell>
        <mxCell id="regBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="π_reg ← θ every 1000 steps&lt;br&gt;(one R-NaD iteration)" vertex="1">
