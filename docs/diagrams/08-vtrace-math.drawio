<mxfile host="Electron" agent="claude-code">
  <diagram id="vtrace-math" name="vtrace-math">
    <mxGraphModel dx="1465" dy="894" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="V-trace — the mathematics, one trajectory at a time (rnad/vtrace.py · RNaDLearner._vtrace_fast) — settings: γ = 1, ρ̄ = c̄ = 1" vertex="1">
          <mxGeometry height="30" width="1200" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="frame1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(1) per-step ingredients (all detached — no gradient flows through any of this)" vertex="1">
          <mxGeometry height="150" width="1420" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="i1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="transformed reward (R-NaD stage 1)&lt;br&gt;r̃_t = r_t − η·(log π(a_t|s_t) − log π_reg(a_t|s_t))&lt;br&gt;r_t = 0 except terminal z ∈ {+1, 0, −1};  η = 0.2" vertex="1">
          <mxGeometry height="90" width="430" x="70" y="100" as="geometry" />
        </mxCell>
        <mxCell id="i2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="critic estimate from the CURRENT net&lt;br&gt;V_t = v_θ(s_t)&lt;br&gt;bootstrap past the last step: V_T = 0 (terminal)" vertex="1">
          <mxGeometry height="90" width="400" x="530" y="100" as="geometry" />
        </mxCell>
        <mxCell id="i3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="importance ratio (target π vs behavior μ)&lt;br&gt;ρ_t = π(a_t|s_t) / μ(a_t|s_t) = exp(log π − log μ)&lt;br&gt;log μ was stored by the actor at play time" vertex="1">
          <mxGeometry height="90" width="470" x="960" y="100" as="geometry" />
        </mxCell>
        <mxCell id="frame2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(2) clipping" vertex="1">
          <mxGeometry height="120" width="680" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="ρ̂_t = min(ρ_t, ρ̄)        ĉ_t = min(ρ_t, c̄)        with ρ̄ = c̄ = 1&lt;br&gt;one-sided: ratios below 1 pass through — actions π now dislikes keep their small weight" vertex="1">
          <mxGeometry height="70" width="620" x="70" y="285" as="geometry" />
        </mxCell>
        <mxCell id="frame3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" value="(3) weighted TD error" vertex="1">
          <mxGeometry height="120" width="680" x="760" y="250" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" value="δ_t = ρ̂_t · ( r̃_t + γ·V_{t+1} − V_t )&lt;br&gt;the one-step TD error of the transformed game, down-weighted where μ over-sampled the action" vertex="1">
          <mxGeometry height="70" width="620" x="790" y="285" as="geometry" />
        </mxCell>
        <mxCell id="frame4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;fontColor=#6C8EBF;" value="(4) backward recurrence — one sweep per trajectory, right to left" vertex="1">
          <mxGeometry height="250" width="1400" x="40" y="410" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="v_t = V_t + δ_t + γ·ĉ_t·( v_{t+1} − V_{t+1} )&lt;br&gt;code form:  acc ← δ_t + ĉ_t·acc ;   vs_t = V_t + acc      (t = T−1 … 0, acc starts at 0)" vertex="1">
          <mxGeometry height="70" width="830" x="70" y="445" as="geometry" />
        </mxCell>
        <mxCell id="t0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" value="t = 0&lt;br&gt;vs_0 = V_0 + acc" vertex="1">
          <mxGeometry height="45" width="170" x="70" y="550" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" value="t = 1" vertex="1">
          <mxGeometry height="45" width="170" x="290" y="550" as="geometry" />
