          <mxGeometry height="45" width="170" x="860" y="550" as="geometry" />
        </mxCell>
        <mxCell id="et1" edge="1" parent="1" source="t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="t0" value="δ_0 + ĉ_0·acc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
