  <diagram id="async-loops" name="actor-learner-loops">
    <mxGraphModel dx="1250" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="tA" value="Actor process (&#215;16, CPU)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="10" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tL" value="Learner (main process, GPU)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="10" width="280" height="20" as="geometry" />
        </mxCell>

        <!-- ================= actor loop ================= -->
        <mxCell id="aStart" value="actor_loop&#160;&#160;(one per actor)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="60" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="aP1" value="pull newest &#952; from weight queue (if any) and load into local net" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aP2" value="play one self-play game&lt;br&gt;&#8594; 2 trajectories" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="aP3" value="put each trajectory into the trajectory queue (timeout 1 s; drop if full)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="aNote" value="loops until stop_event; actors are terminated by the learner at shutdown" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="280" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ae1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="aStart" target="aP1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="aP1" target="aP2">
          <mxGeometry relative="1" as="geometry" />
