              <mxPoint x="40" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ================= learner loop ================= -->
        <mxCell id="lStart" value="run_async&#160;&#160;(main process)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="50" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lInit" value="initialize: net &#952; on GPU, R-NaD learner, replay buffer; optional resume; spawn 16 actors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lP1" value="drain &#8804; 64 trajectories from queue into replay buffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="350" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lD2" value="len(buffer) &#8805; 64 ?&lt;br&gt;(warm-up gate)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="430" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lSleep" value="sleep 50 ms&lt;br&gt;(deadlock detection: actors alive?)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="445" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lP3" value="sample 32 trajectories &#8594; one R-NaD update; step &#8592; learner steps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="550" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lP4" value="step &#8801; 0 (mod 20): broadcast &#952; to actors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="640" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lP5" value="step &#8801; 0 (mod eval_every): skill eval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="710" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lP6" value="step &#8801; 0 (mod 10 000): save checkpoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="780" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lD3" value="step &#160;&lt; 80 000 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="850" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lEnd" value="shutdown: stop_event, terminate actors" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="870" width="240" height="40" as="geometry" />
        </mxCell>

